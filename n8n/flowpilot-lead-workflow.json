        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'email', operator: 'EQ', value: $json.crmContact.email }] }], properties: ['email', 'firstname', 'lastname', 'company'], limit: 1 }) }}",
