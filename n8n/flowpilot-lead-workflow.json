        "jsCode": "const persisted = $json;\nconst parts = String(persisted.lead.name ?? '').trim().split(/\\s+/).filter(Boolean);\nconst firstname = parts.shift() ?? '';\nconst lastname = parts.join(' ');\n\nreturn [{\n  json: {\n    ...persisted,\n    crmContact: {\n      email: persisted.lead.email,\n      firstname,\n      lastname,\n      company: persisted.lead.company,\n    },\n  },\n}];"
      },
