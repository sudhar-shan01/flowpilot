    {
      "parameters": {
        "jsCode": "const stored = $json;\n\nif (!stored.id || !stored.created_at) {\n  return [{\n    json: {\n      success: false,\n      statusCode: 503,\n      error: {\n        code: 'PERSISTENCE_ERROR',\n        message: 'Lead was analyzed but could not be saved.',\n      },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    created_at: stored.created_at,\n    lead: {\n      name: stored.name,\n      email: stored.email,\n      company: stored.company,\n      message: stored.message,\n      budget: Number(stored.budget),\n    },\n    analysis: {\n      category: stored.category,\n      priority: stored.priority,\n      lead_score: stored.lead_score,\n      short_summary: stored.short_summary,\n      recommended_action: stored.recommended_action,\n    },\n  },\n}];"
