      "id": "45c5e8b7-e21a-4550-93aa-651aef8d653f",
      "name": "Analyze Lead with FlowPilot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst statusCode = Number(response.statusCode ?? 0);\n\nconst errorResult = (code, message, responseStatus) => [{\n  json: {\n    success: false,\n    statusCode: responseStatus,\n    error: { code, message },\n  },\n}];\n\nif (!statusCode) {\n  return errorResult(\n    'FLOWPILOT_UNAVAILABLE',\n    'FlowPilot API is unavailable. Please try again later.',\n    503,\n  );\n}\n\nif (statusCode === 422) {\n  return errorResult(\n    'VALIDATION_ERROR',\n    'Lead payload failed validation.',\n    422,\n  );\n}\n\nif (statusCode < 200 || statusCode >= 300) {\n  return errorResult(\n    'FLOWPILOT_ERROR',\n    'FlowPilot could not analyze the lead.',\n    statusCode === 503 ? 503 : 502,\n  );\n}\n\nconst analysis = response.body;\nconst priorities = new Set(['high', 'medium', 'low']);\nconst isNonEmptyString = (value) =>\n  typeof value === 'string' && value.trim().length > 0;\nconst isValid =\n  analysis &&\n  typeof analysis === 'object' &&\n  !Array.isArray(analysis) &&\n  isNonEmptyString(analysis.category) &&\n  priorities.has(analysis.priority) &&\n  Number.isInteger(analysis.lead_score) &&\n  analysis.lead_score >= 0 &&\n  analysis.lead_score <= 100 &&\n  isNonEmptyString(analysis.short_summary) &&\n  isNonEmptyString(analysis.recommended_action);\n\nif (!isValid) {\n  return errorResult(\n    'INVALID_FLOWPILOT_RESPONSE',\n    'FlowPilot returned an unexpected response.',\n    502,\n  );\n}\n\nconst lead = $('Prepare Lead').item.json;\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    lead,\n    analysis,\n  },\n}];"
      },
