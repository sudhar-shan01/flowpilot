# CORE
FLOWPILOT_LOG_LEVEL=INFO
FLOWPILOT_API_PORT=8000
FLOWPILOT_BIND_ADDRESS=0.0.0.0

# DATABASE
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# AI
# The health endpoint works without an API key. Analysis and drafts require one.
FLOWPILOT_AI_PROVIDER=openai
OPENAI_API_KEY=
FLOWPILOT_OPENAI_MODEL=gpt-4o-mini
FLOWPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
FLOWPILOT_AI_TIMEOUT_SECONDS=20

# N8N
FLOWPILOT_N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# INGRESS
# Optional for local use. The production Compose layer requires a strong value.
FLOWPILOT_WEBHOOK_INGRESS_SECRET=

# EMAIL
# Keep real addresses and SMTP configuration local. SMTP credentials belong in
# the n8n credential named "FlowPilot Email" and never in this file.
FLOWPILOT_INTERNAL_EMAIL_TO=
FLOWPILOT_INTERNAL_EMAIL_FROM=
FLOWPILOT_LEAD_EMAIL_FROM=

# APPROVAL
FLOWPILOT_APPROVAL_URL=

# HUBSPOT
# Configure the "FlowPilot HubSpot" credential in n8n. No token is stored here.

# GOOGLE SHEETS
# Configure the "FlowPilot Google Sheets" OAuth credential and target sheet in n8n.
