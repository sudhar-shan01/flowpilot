# Copy to a root-owned .env.prod on the VM and set mode 600. Never commit it.

# PUBLIC INGRESS
# Domain deployment: FLOWPILOT_CADDY_SITE=flowpilot.example.com
# Temporary IP test only: FLOWPILOT_CADDY_SITE=http://203.0.113.10
FLOWPILOT_CADDY_SITE=
FLOWPILOT_PUBLIC_HOST=
FLOWPILOT_PUBLIC_ORIGIN=
FLOWPILOT_PUBLIC_PROTOCOL=https
FLOWPILOT_HTTP_PORT=80
FLOWPILOT_HTTPS_PORT=443
FLOWPILOT_BIND_ADDRESS=127.0.0.1
FLOWPILOT_WEBHOOK_INGRESS_SECRET=

# DATABASE
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=

# AI
FLOWPILOT_AI_PROVIDER=openai
OPENAI_API_KEY=
FLOWPILOT_OPENAI_MODEL=gpt-4o-mini
FLOWPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
FLOWPILOT_AI_TIMEOUT_SECONDS=20
FLOWPILOT_LOG_LEVEL=INFO

# N8N
FLOWPILOT_API_PORT=8000
FLOWPILOT_N8N_PORT=5678
N8N_ENCRYPTION_KEY=
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# EMAIL ROUTING (SMTP credentials remain in n8n's encrypted credential store)
FLOWPILOT_INTERNAL_EMAIL_TO=
FLOWPILOT_INTERNAL_EMAIL_FROM=
FLOWPILOT_LEAD_EMAIL_FROM=

# HubSpot OAuth and Google Sheets OAuth credentials remain in n8n.
