      "parameters": {
        "jsCode": "const response = $json;\nconst prepared = $('Determine HubSpot Contact Path').item.json;\nconst statusCode = Number(response.statusCode ?? 0);\nconst result = response.body;\n\nif (statusCode < 200 || statusCode >= 300 || !result || typeof result !== 'object' || !result.id) {\n  return [{\n    json: {\n      success: false,\n      statusCode: 503,\n      error: {\n        code: 'CRM_ERROR',\n        message: 'Lead was persisted but could not be synchronized with CRM.',\n      },\n    },\n  }];\n}\n\nconst { crmContact, ...workflowData } = prepared;\nreturn [{ json: workflowData }];"
