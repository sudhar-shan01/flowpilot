      "credentials": {
        "hubspotOAuth2Api": {
          "id": "43d9a6de-aeb2-47ee-ad91-1c9448f3dc19",
          "name": "FlowPilot HubSpot"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst prepared = $('Prepare HubSpot Contact').item.json;\nconst statusCode = Number(response.statusCode ?? 0);\n\nconst crmError = () => [{\n  json: {\n    success: false,\n    statusCode: 503,\n    error: {\n      code: 'CRM_ERROR',\n      message: 'Lead was persisted but could not be synchronized with CRM.',\n    },\n  },\n}];\n\nif (statusCode < 200 || statusCode >= 300) {\n  return crmError();\n}\n\nconst result = response.body;\nif (!result || typeof result !== 'object' || !Array.isArray(result.results)) {\n  return crmError();\n}\n\nif (result.results.length === 0) {\n  return [{\n    json: {\n      ...prepared,\n      crmContact: { ...prepared.crmContact, action: 'create' },\n    },\n  }];\n}\n\nconst contactId = result.results[0]?.id;\nif (!contactId) {\n  return crmError();\n}\n\nreturn [{\n  json: {\n    ...prepared,\n    crmContact: {\n      ...prepared.crmContact,\n      action: 'update',\n      contactId: String(contactId),\n    },\n  },\n}];"
      },
