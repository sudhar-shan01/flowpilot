      "parameters": {
        "jsCode": "const sheetsResult = $json;\nconst persisted = $('Sanitize Persistence Result').item.json;\nconst sheetsFailed = Boolean(sheetsResult.error) || sheetsResult.success === false;\n\nif (sheetsFailed || !persisted?.success || !persisted?.created_at) {\n  return [{\n    json: {\n      success: false,\n      statusCode: 503,\n      error: {\n        code: 'PERSISTENCE_ERROR',\n        message: 'Lead was analyzed but could not be fully persisted.',\n      },\n    },\n  }];\n}\n\nreturn [{ json: persisted }];"
