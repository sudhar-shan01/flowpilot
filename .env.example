# The health endpoint works without an API key. Lead analysis requires one.
FLOWPILOT_AI_PROVIDER=openai
OPENAI_API_KEY=
FLOWPILOT_OPENAI_MODEL=gpt-4o-mini
FLOWPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
FLOWPILOT_AI_TIMEOUT_SECONDS=20
FLOWPILOT_LOG_LEVEL=INFO

# Local PostgreSQL used by the Phase 3A n8n persistence step.
# Set POSTGRES_PASSWORD only in .env and in the matching n8n credential.
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Phase 5 internal notification routing. Keep real addresses in .env only.
FLOWPILOT_INTERNAL_EMAIL_TO=
FLOWPILOT_INTERNAL_EMAIL_FROM=

# Phase 6 approval links and approved lead-email sender.
# Set the URL to the production webhook of the imported approval workflow,
# for example https://n8n.example.com/webhook/flowpilot/approval.
FLOWPILOT_APPROVAL_URL=
FLOWPILOT_LEAD_EMAIL_FROM=
